{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the existing worker bound to planner.chinookcyber.com —
  // a different name makes wrangler create a new worker instead of updating it.
  "name": "cyber-planning-web-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
